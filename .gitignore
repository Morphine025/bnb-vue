# ===========================================
# UniApp 民宿转让平台 .gitignore
# ===========================================

# ===========================================
# 依赖目录
# ===========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===========================================
# 构建输出目录
# ===========================================
# UniApp 构建输出
unpackage/
dist/
build/

# 微信小程序构建输出
miniprogram/
miniprogram_npm/

# H5构建输出
h5/
www/

# App构建输出
app/
android/
ios/

# ===========================================
# 开发工具配置
# ===========================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# HBuilderX
.hbuilderx/
.hbuilderx/

# WebStorm/IntelliJ
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# ===========================================
# 操作系统生成的文件
# ===========================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~

